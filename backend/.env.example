# ==========================================
# RoadSetu Backend - Environment Configuration
# ==========================================

# Port (Render sets this dynamically via $PORT, defaults to 5000)
PORT=5000

# Environment mode ('production' or 'development')
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/roadsetu?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roadsetu?retryWrites=true&w=majority

# JWT Authentication Secret Key (use a secure random string of 32+ characters)
JWT_SECRET=super_secret_jwt_random_key_replace_this_for_production

# Frontend Client URL(s)
# Supports comma-separated list of allowed origins (e.g. Vercel deployment URL & localhost)
# Wildcards on *.vercel.app are also automatically supported
CLIENT_URL=https://your-roadsetu-frontend.vercel.app,http://localhost:5173
